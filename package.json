{
  "name": "envy-ts",
  "version": "1.0.0",
  "description": "Tiny, zero-dependency, type-safe environment variable parsing for Node.js, Bun and Deno.",
  "keywords": [
    "env",
    "environment",
    "environment-variables",
    "config",
    "configuration",
    "dotenv",
    "typescript",
    "type-safe",
    "node",
    "bun",
    "deno"
  ],
  "license": "MIT",
  "author": "envy-ts contributors",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./load": {
      "import": {
        "types": "./dist/load.d.ts",
        "default": "./dist/load.js"
      },
      "require": {
        "types": "./dist/load.d.cts",
        "default": "./dist/load.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "load": [
        "./dist/load.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "node scripts/type-tests.mjs",
    "test:coverage": "vitest run --coverage",
    "verify:package": "node --no-deprecation scripts/verify-package.mjs",
    "verify:deno": "deno run --allow-env scripts/verify-deno.ts",
    "check:package": "npm run build && npm run verify:package && npx publint",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run test:types && npm run build && npm run check:package",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "publint": "^0.3.24",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
